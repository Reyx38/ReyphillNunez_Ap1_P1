@page "/Prestamos/Details/{PrestamosId:int}"
@rendermode InteractiveServer
@inject PrestamoService PrestamosServices
@inject NavigationManager Navigation
<div class="container">
	<div class="card shadow-lg">

	<div class="card-header">
		<h2 class="card-title">Detalles prestamos</h2>
	</div>
	<div class="card-body">
		<ul>
			@*Datos*@
			<li>Id: @Prestamo.PrestamoId</li>
			<li>Nombre: @Prestamo.Deudor?.Nombres</li>
			<li>Concepto: @Prestamo.Concepto</li>
			<li>Deuda: @Prestamo.Monto</li>
		</ul>
	</div>
	<div class="card-footer">
		<a href="/Registro/Index" class="btn btn-outline-primary bi bi-arrow-left"></a>
	</div>
</div>

</div>
@code {
	[Parameter]
	public int PrestamosId { get; set; }
	public Prestamos Prestamo { get; set; } = new Prestamos();

	protected override async Task OnInitializedAsync()
	{
		Prestamo = await PrestamosServices.Buscar(PrestamosId);
	}
}
