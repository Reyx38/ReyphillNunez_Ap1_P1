@page "/Prestamos/Create"
@rendermode InteractiveServer
@inject PrestamoService PrestamosServices
@inject DeudorServices DeudorService
@inject NavigationManager Navigation


<EditForm Model="Prestamo" OnValidSubmit="Crear">
	<DataAnnotationsValidator/>

	<div class="Container">
		<div class="card shadow-lg">
			<div class="card-header">
				<h2 class="card-title"> Crear Prestamo</h2>
			</div>

			<div class="card-body">
				<label class="form-label">Seleccionar Deudor </label>
				<InputSelect class="form-select" @bind-Value="Prestamo.DeudorId">
					@foreach(var deudor in ListDeudores)
					{
						<option value="@deudor.DeudoresId">@deudor.Nombres</option>
					}
				</InputSelect>
				<ValidationMessage For="@(() => Prestamo.DeudorId)" />
		
				<label class="form-label">Concepto</label>
				<InputText class="form-control" @bind-Value="Prestamo.Concepto" placeholder="Compra de un vehiculo"></InputText>
				<ValidationMessage For="@(() => Prestamo.Concepto)" />

				<label class="form-label">Deuda</label>
				<InputNumber class="form-control" @bind-Value="Prestamo.Monto" placeholder="5000$"></InputNumber>
				<ValidationMessage For="@(() => Prestamo.Monto)" />

			</div>

			<div class="card-footer">
				<a href="/Cobro/Index" class="btn btn-outline-primary bi bi-arrow-left">Volver</a>
				<button type="submit" class="btn btn-outline-success bi bi-floppy">Guardar</button>
			</div>

		</div>


	</div>
	
</EditForm>


@code {
	public Prestamos Prestamo { get; set; } = new Prestamos();
	public List<Deudores> ListDeudores { get; set; } = new List<Deudores>();

	protected override async Task OnInitializedAsync()
	{
		ListDeudores = await DeudorService.Listar(d => true);
	}

	public async Task Crear()
	{
		await PrestamosServices.Guardar(Prestamo);
		Navigation.NavigateTo("/Registro/Index");
	}
}
